# Copy to .env and fill in. NEVER commit .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://portfolio:CHANGE_ME@localhost:5432/portfolio
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
# Used only by `python -m app.create_admin` if you prefer env input
ADMIN_EMAIL=you@example.com

# ---- Phase 2
SITE_URL=http://localhost:3000
# Shared secret so the Next.js server can pass the real visitor IP to the contact endpoint.
# Must match INTERNAL_API_KEY in frontend/.env.local. Generate with the same python one-liner as SECRET_KEY.
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_KEY

# ---- Phase 3 (AI). Human approval is ALWAYS required; there is no setting to disable it.
# AI_PROVIDER=mock produces clearly-marked fake drafts for local testing. Use "anthropic" for real drafts.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
# Set to a model id available to your API account (see Anthropic docs). Never assumed free: you pay per token.
AI_MODEL=
# Optional cost estimate inputs (USD per million tokens). 0 => dashboard shows "unknown".
AI_PRICE_IN_PER_MTOK=0
AI_PRICE_OUT_PER_MTOK=0
# Token for external schedulers calling POST /api/v1/worker/tick (header X-Worker-Token). Empty = endpoint disabled.
WORKER_TOKEN=

# ---- Hosts without a shell: first admin is created at startup if none exists (see app/bootstrap_admin.py)
ADMIN_EMAIL=
ADMIN_PASSWORD=
