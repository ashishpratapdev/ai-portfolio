# Server-side only (never exposed to the browser): where the FastAPI backend lives
API_URL=http://localhost:8000
# Public: used to build links to PUBLIC media files only
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Phase 2
# Canonical site origin (no trailing slash). Used for canonical URLs, sitemap, RSS, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Must equal INTERNAL_API_KEY in backend/.env. Server-side only (no NEXT_PUBLIC_ prefix).
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_KEY
# Optional: Google Search Console HTML-tag verification token
GOOGLE_SITE_VERIFICATION=
# Optional privacy-friendly analytics (Plausible). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
